# Configurações do Sistema RAG
# Copie este arquivo para .env e preencha com suas chaves

# OpenAI API Key (obrigatório)
OPENAI_API_KEY=sua-chave-da-openai-aqui

# Configurações do LLM (opcional - usa padrões do settings.py)
LLM_MODEL_TYPE=openai
LLM_MODEL_NAME=gpt-3.5-turbo

# Configurações do Vector Store (opcional)
VECTOR_STORE_DIR=./chroma_db
VECTOR_STORE_COLLECTION=autismo